# Token du bot Discord (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=votre_token_discord_ici
DISCORD_ENABLED=true

# Salon où poster les nouvelles propositions (clic droit → Copier l’identifiant du salon)
# Laisser vide pour désactiver.
DISCORD_ADMIN_CHANNEL_ID=

# Admin panel (ne pas committer les vrais identifiants)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
JWT_SECRET=change-me-to-a-long-random-secret-key-32chars-min

# PostgreSQL (interne Docker, non exposé)
POSTGRES_DB=discord_bot
POSTGRES_USER=discord
POSTGRES_PASSWORD=change_me_strong_password

SPRING_PROFILES_ACTIVE=docker

# Uniquement pour docker-compose.dev.yml (local)
APP_PORT=8088
